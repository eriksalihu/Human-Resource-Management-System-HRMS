# Frontend Configuration (Vite)
#
# All VITE_* variables are OPTIONAL — the app ships with sensible defaults
# for local development. Copy this file to `.env` and override as needed.
#
# Note: Vite only exposes variables prefixed with VITE_ to client code, and
# it inlines them at BUILD time — rebuild (npm run build) after changing.

# Base URL of the backend API, including the /api suffix.
# Default: http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# Version stamp shown in the application footer.
# Default: 1.0.0-dev
VITE_APP_VERSION=1.0.0
