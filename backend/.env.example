# Backend Configuration
#
# This file is OPTIONAL for local development — the app ships with sensible
# defaults (root@localhost, database hrms_db, port 5001, dev JWT keys).
# Copy to `.env` only if you need to override something.
#
# For PRODUCTION, copy this file to `.env` and fill in real values.
# Never commit `.env` files — generate fresh JWT secrets per environment.

# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=hrms_db

# JWT Configuration (use long random strings in production: openssl rand -base64 48)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
